# WhatBot configuration template.
# Copy to .env, fill in MONGODB_URI, ADMIN_PASSWORD, JWT_SECRET and
# TOKEN_API_PUBLIC. Generate secrets with: openssl rand -hex 48

# --- Fill this in ----------------------------------------------------------
MONGODB_URI=

# --- Sign-in ----------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Secrets (JWT_SECRET must be 32+ characters) ----------------------------
JWT_SECRET=
# Token for POST /api/sendMessage (send as X-API-Key header)
TOKEN_API_PUBLIC=

# --- General ---------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
SESSION_TTL_HOURS=168
SESSION_VERSION=1

# --- Behind a reverse proxy / HTTPS ---------------------------------------
# auto = Secure cookie whenever the proxy reports https
COOKIE_SECURE=auto
# Your public URL, e.g. https://bot.example.com (only needed if sign-in
# fails with "Cross-site request blocked" behind a proxy)
APP_ORIGIN=
# Set to 1 once the site is served over HTTPS
ENABLE_HSTS=0
TRUST_PROXY=

# --- WhatsApp --------------------------------------------------------------
# Session folder defaults to ./.baileys_auth (Docker overrides this itself)
WHATSAPP_PROFILE_COUNT=4
WHATSAPP_SEND_TIMEOUT_MS=90000
MAX_MEDIA_MB=10
AUTO_OPT_OUT=1
OPT_OUT_KEYWORDS=stop,unsubscribe,stop all,opt out,optout,cancel

# --- Limits & logging ------------------------------------------------------
API_RATE_LIMIT_PER_MIN=60
LOG_LEVEL=info
LOG_TO_FILE=0
