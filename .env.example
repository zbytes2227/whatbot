# WhatsApp Configuration
# Directory path where WhatsApp web session auth tokens and client states are stored.
# Leave blank to use default workspace directory (./.wwebjs_auth), or specify an absolute persistent volume path:
# Example for local/project folder: ./.wwebjs_auth
# Example for Docker/VPS persistent mount: /app/whatsapp-sessions or /var/data/whatsapp-sessions
WHATSAPP_SESSION_PATH=./.wwebjs_auth
WHATSAPP_INIT_TIMEOUT_MS=60000
WHATSAPP_MAX_RECONNECT_ATTEMPTS=6
WHATSAPP_RECONNECT_BASE_MS=4000
WHATSAPP_RECONNECT_MAX_MS=120000
